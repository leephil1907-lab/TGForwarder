# TGForwarder production environment template
# NEVER commit real Telegram credentials or sessions.

# Telegram MTProto credentials (https://my.telegram.org)
TG_API_ID=""
TG_API_HASH=""

# Optional existing Telegram StringSession. Treat this like a password.
TG_SESSION_STRING=""

# Optional Telegram bot login token.
TG_BOT_TOKEN=""

# REQUIRED in production. Use a long random secret and set the same value
# in Railway/project environment variables.
APP_AUTH_TOKEN=""

# Optional initial forwarding configuration.
TG_SOURCE_ID=""
TG_TARGET_ID=""
TG_FORWARDING_RULES=""

# Persistent data directory. On Railway, mount a Volume at /data.
TG_DATA_DIR="/data"

# Local/VPS server settings.
PORT="3000"
HOST="0.0.0.0"
NODE_ENV="production"
